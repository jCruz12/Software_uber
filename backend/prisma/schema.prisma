datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Employer {
  id        String     @id @default(uuid())
  name      String
  address   String
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Employee {
  id             String                  @id @default(uuid())
  idNum          Int?                    @unique
  lastName       String                  
  firstName      String                  
  status         String                  @default("Activo") 
  contractType   String                  
  startDate      DateTime?               
  contractUntil  DateTime?               
  birthDate      DateTime?               
  krankenkasse   String?                 
  marginalEmp    String?                 @default("-") 
  stNummer       String?                 
  svNummer       String?                 
  address        String?                 
  zipCode        String?                 
  city           String?                 
  employerId     String?
  employer       Employer?               @relation(fields: [employerId], references: [id])
  contracts      Contract[]
  attachedDocs   AttachedDoc[]
  
  // Relaciones para el Sistema de Ganancias y Nóminas
  earningsConfig EmployeeEarningsConfig?
  weeks          EmployeeWeek[]
  fines          EmployeeFine[]

  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
}

model Contract {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String
  content    String?
  createdAt  DateTime @default(now())
}

model AttachedDoc {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String
  fileUrl    String
  createdAt  DateTime @default(now())
}

// Configuración de tarifas y parámetros de ganancias por empleado
model EmployeeEarningsConfig {
  id                String   @id @default(uuid())
  employeeId        String   @unique
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractType      String   @default("Teilzeit")
  contractHours     Float    @default(30)
  hourlyRate        Float    @default(13.90)
  commissionRate    Float    @default(40)
  vacationProvision Float    @default(0)
  cashPaidInHand    Float    @default(0)
  updatedAt         DateTime @updatedAt
}

// Histórico de Semanas de trabajo (Kalenderwoche - KW)
model EmployeeWeek {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kw         String   
  dateRange  String   
  fahrtpreis Float    @default(0)
  aktion     Float    @default(0)
  serviceFee Float    @default(0)
  tip        Float    @default(0)
  createdAt  DateTime @default(now())
}

// Histórico de Multas, Sanciones y Aktenzeichen
model EmployeeFine {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  description  String
  aktenzeichen String   @default("-")
  pin          String   @default("-")
  amount       Float    @default(0)
  createdAt    DateTime @default(now())
}