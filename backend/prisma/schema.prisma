datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Employer {
  id        String     @id @default(uuid())
  name      String
  address   String
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Employee {
  id           String        @id @default(uuid())
  idNum        Int?          @unique
  lastName     String        // Apellido
  firstName    String        // Nombre
  status       String        @default("Activo") // Activo / Inactivo
  contractType String        // Minijob / 1/2 Tiempo / No Aplica
  startDate    DateTime?     // 1er día
  contractUntil DateTime?    // Contrato hasta
  birthDate    DateTime?     // Nacimiento
  krankenkasse String?       // Caja de salud
  marginalEmp  String?       // Empleo marginal (Knapp B-S)
  stNummer     String?       // N° Fiscal
  svNummer     String?       // N° Seguridad Social
  address      String?       // Dirección
  zipCode      String?       // Código Postal
  city         String?       // Ciudad
  employerId   String?
  employer     Employer?     @relation(fields: [employerId], references: [id])
  contracts    Contract[]
  attachedDocs AttachedDoc[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Contract {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String
  content    String?
  createdAt  DateTime @default(now())
}

model AttachedDoc {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String
  fileUrl    String
  createdAt  DateTime @default(now())
}

model EmployeeEarnings {
  id              String   @id @default(uuid())
  employeeId      String   @unique
  contractType    String   @default("Teilzeit")
  contractHours   Float    @default(30)
  hourlyRate      Float    @default(13.90)
  commissionRate  Float    @default(40)
  vacationProv    Float    @default(0)
  cashPaidInHand  Float    @default(0)
  weeksJson       String   // Almacena las semanas en formato JSON
  finesJson       String   // Almacena las multas en formato JSON
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  updatedAt       DateTime @updatedAt
}